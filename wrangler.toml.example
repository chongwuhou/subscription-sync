name = "subscription-sync"
main = "src/worker.js"
compatibility_date = "2026-01-01"
workers_dev = true
preview_urls = false

# This file is an example only. It does not enable any Cloudflare service.
# Replace the placeholder KV namespace id with the ID of the approved
# subscription-sync-state namespace. Keep account-specific IDs out of the
# public repository when this template is used for a private deployment.

[[kv_namespaces]]
binding = "SUBSCRIPTION_STATE"
id = "replace-with-an-approved-kv-namespace-id"

[triggers]
# The Worker fetches the source on a schedule. Public requests only serve the
# last good version from KV.
crons = ["*/30 * * * *"]

# Optional: enable this binding when an audit history is desired. The SQL
# migration stores no source URL, Token, or generated subscription body.
# [[d1_databases]]
# binding = "SUBSCRIPTION_AUDIT"
# database_name = "subscription-sync-audit"
# database_id = "replace-with-an-approved-d1-database-id"
# migrations_dir = "migrations"

[vars]
# Keep the actual source URL and public token out of this file.
# SOURCE_URL, PUBLIC_PATH_TOKEN, RENAME_RULES_JSON and SUBSCRIPTIONS_JSON
# should be configured as secrets or private environment variables by the
# operator. SUBSCRIPTIONS_JSON takes precedence over the single-subscription
# variables.

